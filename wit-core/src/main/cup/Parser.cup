package org.febit.wit.parser;

import org.febit.wit.engine.ParseContext;
import org.febit.wit.exception.ScriptParseException;
import org.febit.wit.io.Source;
import org.febit.wit.ir.*;
import org.febit.wit.ir.expr.*;
import org.febit.wit.ir.expr.NewMap.NewMapEntry;
import org.febit.wit.ir.expr.TemplateStringValue.TemplateStringBuilder;
import org.febit.wit.ir.flow.*;
import org.febit.wit.ir.include.*;
import org.febit.wit.ir.include.Include.IncludeBuilder;
import org.febit.wit.ir.statement.*;
import org.febit.wit.ir.support.*;
import org.febit.wit.ir.template.*;
import org.febit.wit.parser.IR.*;
import org.febit.wit.parser.support.*;

import java.util.List;

import static org.febit.wit.parser.support.FunctionLiteralBuilder.Argument;

/* Terminals */
terminal Integer    VAR,
                    IF, ELSE,
                    FOR,
                    THIS, SUPER,
                    SWITCH, CASE, DEFAULT,
                    DO, WHILE,
                    THROW, TRY, CATCH, FINALLY,
                    NEW,
                    INSTANCEOF,
                    FUNCTION,
                    ECHO,
                    STATIC, NATIVE,
                    IMPORT, INCLUDE, NATIVE_IMPORT,
                    BREAK, CONTINUE, RETURN,

                    PLUSPLUS, MINUSMINUS,  // ++ ==
                    PLUS, MINUS, MULTI, DIV, MOD,  // + - * /
                    LSHIFT, RSHIFT, URSHIFT,  // << >> >>>
                    LT, GT, LTEQ, GTEQ, EQEQ, NOTEQ,  // < > <= >= == !=
                    AND, XOR, OR, COMP,  // & ^ | ~
                    ANDAND, OROR, NOT,  // && || !
                    QUESTION,// ?
                    SELFEQ,  // (+ - * / %)= (<< >> >>>)= (& ^ |)=
                    UMINUS,
                    DOT,  // .
                    COLON, COLONCOLON,  // : ::
                    COMMA,  // ,
                    SEMICOLON,  // ;
                    LBRACE, RBRACE, INTERPOLATION_END, // { }
                    LPAREN, RPAREN,  // ( )
                    LBRACK, RBRACK,  // [ ]
                    LDEBUG, RDEBUG, LRDEBUG,  // [? ?] [?]
                    EQGT,  // =>
                    RPAREN_MINUSGT, MINUSGT, // )-> ->
                    DYNAMIC_DOT, // @ .~
                    DOTDOT,  // ..
                    EQ,   // =
                    TEMPLATE_STRING_START, TEMPLATE_STRING_INTERPOLATION_END;


terminal String     TEMPLATE_STRING_INTERPOLATION_START, TEMPLATE_STRING_END, IDENTIFIER, METHOD_REFERENCE; // Ident, MethodReference
terminal char[]     TEXT_STATEMENT;
terminal Object     DIRECT_VALUE;
terminal Integer    CONST;

/* nonterminal */
nonterminal ClassNameRope classPureName, className;
nonterminal Class<?> javaClass;
nonterminal ScriptIR scriptAST;

/* Statement */
nonterminal Statement statement, ifStat, varPart;
nonterminal IBlock block, caseBlockStat;
nonterminal Expression varAssign;
nonterminal IncludeBuilder importPart1, importPart2;
nonterminal SwitchBuilder switchPart, switchPart0;
nonterminal BaseForInBuilder forInHead, forInPart, lambdaForHead, lambdaForHead2;
nonterminal WhileBuilder whileBuilder;
nonterminal TryCatchBuilder tryPart, catchPart, finallyPart;

/* Expression */
nonterminal Expression expression, expressionStatementAble;
nonterminal NewMapEntry newMapEntry;
nonterminal NewMap newMapExpr;
nonterminal TemplateStringBuilder tmplStringBuilder;
nonterminal Integer superCount;
nonterminal Expression contextValueExpr;

/* function & Lambda */
nonterminal Argument funcArg;
nonterminal Expression funcCall;
nonterminal FunctionLiteralBuilder funcHead, funcStatHead, mapPropertyFuncHead;
nonterminal Expression lambdaExpr;
nonterminal FunctionLiteralBuilder lambdaExprHead;
nonterminal FunctionLiteralBuilder lambdaForHead1, lambdaForMapHead1;

/* precedence */
precedence left     SEMICOLON; // ;
precedence left     COMMA; // ,
precedence left     LDEBUG; // [?
precedence left     RBRACK; // ]
precedence left     COLON;  // :
precedence right    SELFEQ, EQ; // (+ - * / %)=  (<< >> >>>)=  (& ^ |)=  =
precedence left     DOTDOT;  // ..
precedence right    QUESTION; // ?
precedence left     OROR; // ||
precedence left     ANDAND; // &&
precedence left     XOR; // ^
precedence left     OR; // |
precedence left     AND; // &
precedence left     EQEQ, NOTEQ; // == !=
precedence left     LT, LTEQ, GT, GTEQ; // < <= > >=  //Unsupport: instanceOf
precedence left     LSHIFT, RSHIFT, URSHIFT; // << >> >>>
precedence left     PLUS, MINUS; // + -
precedence left     MULTI, DIV, MOD; // * / %
precedence right    PLUSPLUS, MINUSMINUS, UMINUS, NOT, COMP; // ++ -- - ! ~
precedence left     EQGT;  // =>
precedence right    RPAREN_MINUSGT, MINUSGT; // ->
precedence left     DOT, LBRACK, LBRACE, LPAREN, RPAREN, DYNAMIC_DOT; // . [ { ( ) @


scriptAST       ::= statement[]:list ?
                    {: yield assembler.ir().script(%list%); :}
                    ;


classPureName   ::= IDENTIFIER:ident
                    {: yield new ClassNameRope(%ident%); :}
                    |classPureName:rope DOT IDENTIFIER:ident
                    {: yield (%rope%).append(%ident%); :}
                    ;

className       ::= classPureName:rope
                    {: yield %rope%; :}
                    |className:rope LBRACK RBRACK
                    {: yield (%rope%).increaseArrayDepth(); :}
                    ;


javaClass       ::= className:nameRope
                    {: yield assembler.classes().resolve(%nameRope%, %nameRope.symbol%.pos); :}
                    ;


/* statements  */
statement       ::= expressionStatementAble:$ SEMICOLON
                    |SEMICOLON
                    {: yield NoopStatement.INSTANCE; :}

                    |LRDEBUG:sym
                    {: yield IR.breakpointStatement(null, null, %sym.symbol%.pos); :}
                    |LDEBUG:sym expression:mark COLON RDEBUG
                    {: yield IR.breakpointStatement(%mark%, null, %sym.symbol%.pos); :}

                    |expression:expr INTERPOLATION_END
                    {: yield Interpolation.of(%expr%); :}

                    |block:$

                    |ifStat:$

                    // Switch
                    |switchPart:builder
                    {: yield (%builder%).label(0).build(); :}
                    |IDENTIFIER:label COLON switchPart:builder
                    {: yield (%builder%).label(assembler.getLabelIndex(%label%)).build(); :}

                    // While
                    |whileBuilder:builder
                    {: yield (%builder%).build(); :}
                    |IDENTIFIER:label COLON whileBuilder:builder
                    {: yield (%builder%).label(assembler.getLabelIndex(%label%)).build(); :}

                    //forIn
                    |forInPart:builder
                    {: yield (%builder%).label(0).build(); :}
                    |IDENTIFIER:label COLON forInPart:builder
                    {: yield (%builder%).label(assembler.getLabelIndex(%label%)).build(); :}

                    //RedirectOut
                    |block:stat EQGT:sym expression:expr SEMICOLON
                    {: yield IR.renderRedirect(%stat%, IR.castToAssignable(%expr%), %sym.symbol%.pos); :}

                    //textStat
                    |TEXT_STATEMENT:sym
                    {: yield assembler.ir().templateText(%sym%, %sym.symbol%.pos); :}

                    //
                    |CONST IDENTIFIER:ident EQ expression:expr SEMICOLON
                    {: assembler.assignConst(%ident%, %expr%, %ident.symbol%.pos); yield NoopStatement.INSTANCE; :}

                    //var
                    |VAR varPart[COMMA]:parts SEMICOLON
                    {: yield IR.statementList(%parts%, %parts.symbol%.pos); :}

                    //echoStat
                    |ECHO:sym expression:expr SEMICOLON
                    {: yield IR.echo(%expr%, %sym.symbol%.pos); :}

                    //@import
                    |NATIVE_IMPORT:sym classPureName:nameRope SEMICOLON
                    {: assembler.classes().imports(%nameRope%, %sym.symbol%.pos); yield NoopStatement.INSTANCE; :}

                    // Break
                    |BREAK:sym IDENTIFIER:label? SEMICOLON
                    {: yield IR.breakTo(assembler.getLabelIndex(%label%), %sym.symbol%.pos); :}

                    // Continue
                    |CONTINUE:sym IDENTIFIER:label? SEMICOLON
                    {: yield IR.continueTo(assembler.getLabelIndex(%label%), %sym.symbol%.pos); :}

                    // Return
                    |RETURN:sym expression:expr? SEMICOLON
                    {: yield IR.returnWith(%expr%, %sym.symbol%.pos); :}

                    // Import
                    |importPart1:builder SEMICOLON
                    {: yield (%builder%).build(); :}
                    |importPart2:builder SEMICOLON
                    {: yield (%builder%).build(); :}

                    // Include
                    |INCLUDE:sym expression:expr newMapExpr:paramsExpr? SEMICOLON
                    {: yield Include.builder().withoutExport(true).refer(assembler.scriptPath()).path(%expr%).params(%paramsExpr%).pos(%sym.symbol%.pos).build(); :}

                    //funcStatement
                    |funcStatHead:builder LBRACE statement[]:list? RBRACE
                    {: yield (%builder%).buildAndAssign(%list%); :}

                    |(catchPart:$ | finallyPart:$):builder
                    {: yield (%builder%).build(); :}

                    | THROW:sym expression:expr SEMICOLON
                    {: yield IR.throwWith(%expr%, %sym.symbol%.pos); :}
                    ;


varAssign       ::= IDENTIFIER:ident EQ:sym (expression:$ | varAssign:$):expr
                    {: yield IR.assign(assembler.ir().declareAndLocate(%ident%, %ident.symbol%.pos), %expr%, %sym.symbol%.pos); :}
                    ;

varPart         ::= varAssign:$
                    | IDENTIFIER:ident
                    {: yield assembler.ir().declare(%ident%, %ident.symbol%.pos); :}
                    | LBRACK IDENTIFIER[COMMA]:idents RBRACK EQ:sym expression:expr
                    {: yield IR.destructuringAssign(assembler.ir().declareAndLocate(%idents%, %idents.symbol%.pos), %expr%, %sym.symbol%.pos); :}
                    ;


importPart1     ::= IMPORT:sym expression:expr newMapExpr:paramsExpr?
                    {: yield Include.builder().refer(assembler.scriptPath()).path(%expr%).params(%paramsExpr%).pos(%sym.symbol%.pos); :}
                    ;


importPart2     ::= importPart1:builder IDENTIFIER:ident
                    {: yield (%builder%).exportTo(%ident%, IR.castToAssignable(assembler.ir().locate(0, %ident%, %ident.symbol%.pos))); :}
                    |importPart1:builder contextValueExpr:valueExpr EQ IDENTIFIER:ident
                    {: yield (%builder%).exportTo(%ident%, IR.castToAssignable(%valueExpr%)); :}
                    |importPart2:builder COMMA IDENTIFIER:ident
                    {: yield (%builder%).exportTo(%ident%, IR.castToAssignable(assembler.ir().locate(0, %ident%, %ident.symbol%.pos))); :}
                    |importPart2:builder COMMA contextValueExpr:valueExpr EQ IDENTIFIER:ident
                    {: yield (%builder%).exportTo(%ident%, IR.castToAssignable(%valueExpr%)); :}
                    ;


block           ::= (LBRACE {: assembler.vars().shiftScope(); yield null; :}) statement[]:list? RBRACE
                    {: yield IR.block(%list%, assembler.vars().unshiftScope(), %list.symbol%.pos); :}
                    ;


tryPart         ::= (TRY LBRACE {: assembler.vars().shiftScope(); yield null; :}):sym statement[]:list? RBRACE
                    {: yield IR.tryCatchBuilder().body(IR.block(%list%, assembler.vars().unshiftScope(), %list.symbol%.pos)).pos(%sym.symbol%.pos); :}
                    ;

catchPart       ::= tryPart:builder (CATCH LPAREN IDENTIFIER:ident RPAREN LBRACE {: assembler.vars().shiftScope(); yield assembler.vars().assignVar(%ident%, %ident.symbol%.pos); :}):varSlot statement[]:list? RBRACE
                    {: yield (%builder%).exceptionVarSlot((Integer)(%varSlot%)).catchBody(IR.block(%list%, assembler.vars().unshiftScope(), %list.symbol%.pos)); :}
                    ;

finallyPart     ::= (tryPart:$ | catchPart:$):builder (FINALLY LBRACE {: assembler.vars().shiftScope(); yield null; :}) statement[]:list? RBRACE
                    {: yield (%builder%).finallyBody(IR.block(%list%, assembler.vars().unshiftScope(), %list.symbol%.pos)); :}
                    ;


ifStat          ::= IF:sym LPAREN expression:expr RPAREN block:body (ELSE block:$ | ELSE ifStat:$):elseBody?
                    {: yield IR.ifStatement(%expr%, %body%, (Statement) (%elseBody%), %sym.symbol%.pos); :}
                    ;

forInHead       ::= FOR:sym LPAREN IDENTIFIER:item COLON expression:items RPAREN
                    {: yield new ForInBuilder(%item%, assembler.vars(), %sym.symbol%.pos).collection(%items%).shiftScope(); :}
                    |FOR:sym LPAREN IDENTIFIER:key COMMA IDENTIFIER:value COLON expression:map RPAREN
                    {: yield new ForMapBuilder(%key%, %value%, assembler.vars(), %sym.symbol%.pos).collection(%map%).shiftScope(); :}
                    ;


lambdaForHead1  ::= FOR LPAREN IDENTIFIER:ident MINUSGT:sym
                    {: yield FunctionLiteralBuilder.create(assembler.vars(), %sym.symbol%.pos).arg(%ident%); :}
                    ;


lambdaForMapHead1   ::= FOR LPAREN IDENTIFIER:key COMMA IDENTIFIER:value MINUSGT:sym
                    {: yield FunctionLiteralBuilder.create(assembler.vars(), %sym.symbol%.pos).arg(%key%).arg(%value%); :}
                    ;


lambdaForHead2  ::= lambdaForHead1:builder expression:expr COLON
                    {: yield new ForInBuilder((%builder%).argAt(0), assembler.vars(), %builder.symbol%.pos).filter((%builder%).build(%expr%)); :}
                    |lambdaForHead1:builder LBRACE statement[]:list RBRACE COLON
                    {: yield new ForInBuilder((%builder%).argAt(0), assembler.vars(), %builder.symbol%.pos).filter((%builder%).build(%list%)); :}
                    |lambdaForMapHead1:builder expression:expr COLON
                    {: yield new ForMapBuilder((%builder%).argAt(0), (%builder%).argAt(1), assembler.vars(), %builder.symbol%.pos).filter((%builder%).build(%expr%)); :}
                    |lambdaForMapHead1:builder LBRACE statement[]:list RBRACE COLON
                    {: yield new ForMapBuilder((%builder%).argAt(0), (%builder%).argAt(1), assembler.vars(), %builder.symbol%.pos).filter((%builder%).build(%list%)); :}
                    ;


lambdaForHead   ::= lambdaForHead2:builder expression:items RPAREN
                    {: yield (%builder%).collection(%items%).shiftScope(); :}
                    ;


forInPart       ::= (forInHead:$ | lambdaForHead:$):builder LBRACE statement[]:list? RBRACE (ELSE block:$):elseBody?
                    {: yield (%builder%).body(%list%).elseBody(%elseBody%); :}
                    ;


whileBuilder       ::= WHILE:sym LPAREN expression:condition RPAREN block:body
                    {: yield IR.whileBuilder().kind(WhileKind.WHILE).condition(%condition%).body(%body%).pos(%sym.symbol%.pos); :}
                    |DO:sym block:body WHILE LPAREN expression:condition RPAREN SEMICOLON
                    {: yield IR.whileBuilder().kind(WhileKind.DO_WHILE).condition(%condition%).body(%body%).pos(%sym.symbol%.pos); :}
                    ;


caseBlockStat   ::= {: assembler.vars().shiftScope(); yield null; :} statement[]:list?
                    {: yield IR.block(%list%, assembler.vars().unshiftScope(), %list.symbol%.pos); :}
                    ;


switchPart0     ::=
                    {: yield IR.switchBuilder(); :}
                    | CASE:sym MINUS:negative? DIRECT_VALUE:key COLON caseBlockStat:body switchPart0:builder
                    {: yield (%builder%).branch((%negative% == null)?(%key%):ALU.negative(%key%), %body%, %sym.symbol%.pos); :}
                    | DEFAULT:sym COLON caseBlockStat:body switchPart0:builder
                    {: yield (%builder%).branch(null, %body%, %sym.symbol%.pos); :}
                    ;


switchPart      ::= SWITCH:sym LPAREN expression:switchExpr RPAREN LBRACE TEXT_STATEMENT ? switchPart0:builder RBRACE
                    {: yield (%builder%).condition(%switchExpr%, %sym.symbol%.pos); :}
                    ;



/* Expressions */

expressionStatementAble ::=
                    //assignOp =
                    expression:lexpr EQ:sym expression:expr
                    {: yield IR.assign(IR.castToAssignable(%lexpr%), %expr%, %sym.symbol%.pos); :}

                    |LBRACK expression[COMMA]:list COMMA? RBRACK EQ:sym expression:expr
                    {: yield IR.destructuringAssign(ExpressionArray.of(%list%), %expr%, %sym.symbol%.pos); :}

                    // Increase ++
                    |PLUSPLUS:sym expression:expr
                    {: yield IR.increaseAndGet(IR.castToAssignable(%expr%), %sym.symbol%.pos); :}
                    |expression:expr PLUSPLUS:sym
                    {: yield IR.getAndIncrease(IR.castToAssignable(%expr%), %sym.symbol%.pos); :}

                    // Decrease --
                    |MINUSMINUS:sym expression:expr
                    {: yield IR.decreaseAndGet(IR.castToAssignable(%expr%), %sym.symbol%.pos); :}
                    |expression:expr MINUSMINUS:sym
                    {: yield IR.getAndDecrease(IR.castToAssignable(%expr%), %sym.symbol%.pos); :}

                    //selfOp
                    |expression:lexpr SELFEQ:sym expression:rexpr
                    {: yield IR.selfAssign(%lexpr%, %rexpr%, %sym%, %sym.symbol%.pos); :}

                    //
                    |funcCall:$
                    ;


expression      ::= expressionStatementAble:$

                    |LDEBUG:sym expression:expr RDEBUG
                    {: yield IR.breakpointExpr(null, %expr%, %sym.symbol%.pos); :}

                    |LDEBUG:sym expression:mark COLON expression:expr RDEBUG
                    {: yield IR.breakpointExpr(%mark%, %expr%, %sym.symbol%.pos); :}

                    //bitNotOp ~
                    |COMP:sym expression:expr
                    {: yield IR.operator(%expr%, %sym.symbol%); :}

                    //negativeOp  -
                    |MINUS:sym expression:expr %prec UMINUS
                    {: yield IR.operator(%expr%, %sym.symbol%); :}

                    //notOp !
                    |NOT:sym expression:expr
                    {: yield IR.operator(%expr%, %sym.symbol%); :}

                    // Fixed property .
                    |expression:expr DOT:sym IDENTIFIER:ident
                    {: yield IR.property(%expr%, %ident%, %sym.symbol%.pos); :}

                    // property []
                    |expression:lexpr LBRACK:sym expression:rexpr RBRACK
                    {: yield IR.property(%lexpr%, %rexpr%, %sym.symbol%.pos); :}

                    /***********  binaries *************/
                    //-- binary:  *
                    |expression:lexpr MULTI:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  /
                    |expression:lexpr DIV:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  %
                    |expression:lexpr MOD:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  +
                    |expression:lexpr PLUS:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  -
                    |expression:lexpr MINUS:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  <<
                    |expression:lexpr LSHIFT:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  >>
                    |expression:lexpr RSHIFT:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  >>>
                    |expression:lexpr URSHIFT:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  <
                    |expression:lexpr LT:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  <=
                    |expression:lexpr LTEQ:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  >
                    |expression:lexpr GT:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  >=
                    |expression:lexpr GTEQ:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  ==
                    |expression:lexpr EQEQ:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  !=
                    |expression:lexpr NOTEQ:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  &
                    |expression:lexpr AND:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  |
                    |expression:lexpr OR:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  ^
                    |expression:lexpr XOR:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  &&
                    |expression:lexpr ANDAND:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  ..
                    |expression:lexpr DOTDOT:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  ||
                    |expression:lexpr OROR:sym expression:rexpr
                    {: yield IR.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}

                    // ? :
                    |expression:ternary QUESTION:sym expression:lexpr COLON expression:rexpr
                    {: yield IR.ternary(%ternary%, %lexpr%, %rexpr%, %sym.symbol%.pos); :}

                    //
                    |DIRECT_VALUE:sym
                    {: yield IR.constant(%sym.symbol%); :}

                    // ()
                    |LPAREN expression:$ RPAREN

                    //funcDeclareExpr
                    |funcHead:builder LBRACE statement[]:list? RBRACE
                    {: yield (%builder%).buildAndAssign(%list%); :}

                    //arrayValue
                    |LBRACK:sym RBRACK
                    {: yield IR.emptyArray(%sym.symbol%.pos); :}
                    |LBRACK:sym expression[COMMA]:list COMMA? RBRACK
                    {: yield IR.newArray(%list%, %sym.symbol%.pos); :}

                    //NativeNewArrayDeclareExpression
                    |NATIVE:sym LBRACK RBRACK javaClass:javaClass
                    {: yield assembler.ir().newNativeArray(%javaClass%, %sym.symbol%.pos); :}

                    //nativeMethodExpr
                    |NATIVE:sym classPureName:nameRope DOT IDENTIFIER:ident LPAREN javaClass[COMMA]:list? RPAREN
                    {: yield assembler.ir().nativeMethod(assembler.classes().resolve(%nameRope%, %nameRope.symbol%.pos), %ident%, %list%, %sym.symbol%.pos); :}

                    //native static field
                    |NATIVE classPureName:nameRope
                    {: yield assembler.ir().staticNativeField(%nameRope%, %nameRope.symbol%.pos); :}

                    //nativeConstructorExpr
                    |NATIVE:sym NEW classPureName:nameRope LPAREN javaClass[COMMA]:list? RPAREN
                    {: yield assembler.ir().nativeNew(assembler.classes().resolve(%nameRope%, %nameRope.symbol%.pos), %list%, %sym.symbol%.pos); :}

                    |METHOD_REFERENCE:ref
                    {: yield assembler.ir().nativeMethodReference(%ref%, %ref.symbol%.pos); :}

                    |contextValueExpr:$
                    |newMapExpr:$

                    //Lambda
                    |lambdaExpr:$

                    // script string
                    |tmplStringBuilder:builder TEMPLATE_STRING_END:end
                    {: yield (%builder%).segment(IR.constant(%end.symbol%)).build(); :}
                    ;

// super
superCount      ::= SUPER DOT
                    {: yield 1; :}
                    |superCount:count SUPER DOT
                    {: yield %count% + 1; :}
                    ;


// ident  super...ident  this.ident

contextValueExpr    ::= IDENTIFIER:ident
                    {: yield assembler.ir().locate(0, %ident%, %ident.symbol%.pos); :}
                    |superCount:count IDENTIFIER:ident
                    {: yield assembler.ir().locate(%count%, %ident%, %ident.symbol%.pos); :}
                    |FOR DOT IDENTIFIER:ident
                    {: yield assembler.ir().locate(0, ("for." + %ident%), %ident.symbol%.pos); :}
                    |superCount:count FOR DOT IDENTIFIER:ident
                    {: yield assembler.ir().locate(%count%, ("for." + %ident%), %ident.symbol%.pos); :}
                    ;

// map {key:expr, ...}

newMapEntry     ::= DIRECT_VALUE:key COLON expression:expr
                    {: yield IR.entryOfNewMap(IR.constant(%key.symbol%), %expr%); :}
                    |MINUS:sym DIRECT_VALUE:key COLON expression:expr
                    {: yield IR.entryOfNewMap(IR.constant(ALU.negative(%key%), %key.symbol%.pos), %expr%); :}
                    |IDENTIFIER:ident
                    {: yield IR.entryOfNewMap(IR.constant(%ident.symbol%), assembler.ir().locate(0, %ident%, %ident.symbol%.pos)); :}
                    |IDENTIFIER:ident COLON expression:expr
                    {: yield IR.entryOfNewMap(IR.constant(%ident.symbol%), %expr%); :}
                    // |IDENTIFIER:ident mapPropertyFuncHead:builder LBRACE statement[]:list? RBRACE
                    // {: yield IR.entryOfNewMap(IR.constant(%ident.symbol%), (%builder%).build(%list%)); :}
                    |LBRACK expression:key RBRACK COLON expression:expr
                    {: yield IR.entryOfNewMap(%key%, %expr%); :}
                    ;


newMapExpr      ::= LBRACE:sym RBRACE
                    {: yield IR.newMap(List.of(), %sym.symbol%.pos); :}
                    |LBRACE:sym newMapEntry[COMMA]:entries COMMA? RBRACE
                    {: yield IR.newMap(%entries%, %sym.symbol%.pos); :}
                    ;


tmplStringBuilder  ::= TEMPLATE_STRING_START:sym
                    {: yield TemplateStringValue.builder().pos(%sym.symbol%.pos); :}
                    | tmplStringBuilder:builder TEMPLATE_STRING_INTERPOLATION_START:start expression:segment TEMPLATE_STRING_INTERPOLATION_END
                    {: yield (%builder%).segment(IR.constant(%start.symbol%)).segment(%segment%); :}
                    ;

/* function  */
funcArg         ::= IDENTIFIER:ident
                    {: yield FunctionLiteralBuilder.ofArgument(%ident%, null); :}
                    | IDENTIFIER:ident EQ expression:expr
                    {: yield FunctionLiteralBuilder.ofArgument(%ident%, StatementUtils.evalAsConst(%expr%)); :}
                    ;


funcStatHead    ::= FUNCTION:sym IDENTIFIER:ident LPAREN funcArg[COMMA]:args? RPAREN
                    {: yield FunctionLiteralBuilder.create(assembler.vars(), assembler.vars().assignVar(%ident%, %ident.symbol%.pos), %sym.symbol%.pos).args(%args%); :}
                    ;

// mapPropertyFuncHead ::= LPAREN:sym funcArg[COMMA]:args? RPAREN
//                     {: yield FunctionLiteralBuilder.create(assembler.vars(), %sym.symbol%.pos).args(%args%); :}
//                     ;

funcHead        ::= FUNCTION:sym LPAREN funcArg[COMMA]:args? RPAREN
                    {: yield FunctionLiteralBuilder.create(assembler.vars(), %sym.symbol%.pos).args(%args%); :}
                    ;

funcCall        ::= expression:funcExpr LPAREN RPAREN
                    {: yield IR.functionCall(%funcExpr%, ExpressionArray.ofEmpty(), %funcExpr.symbol%.pos); :}
                    |expression:funcExpr LPAREN expression[COMMA]:list COMMA? RPAREN
                    {: yield IR.functionCall(%funcExpr%, ExpressionArray.of(%list%), %funcExpr.symbol%.pos); :}
                    |expression:param0 DYNAMIC_DOT IDENTIFIER:ident LPAREN RPAREN
                    {: yield IR.dynamicNativeCall(%param0%, %ident%, ExpressionArray.ofEmpty(), %ident.symbol%.pos); :}
                    |expression:param0 DYNAMIC_DOT IDENTIFIER:ident LPAREN expression[COMMA]:list COMMA? RPAREN
                    {: yield IR.dynamicNativeCall(%param0%, %ident%, ExpressionArray.of(%list%), %ident.symbol%.pos); :}
                    ;


/* lambda */
lambdaExprHead  ::= IDENTIFIER:ident MINUSGT:sym
                    {: yield FunctionLiteralBuilder.create(assembler.vars(), %sym.symbol%.pos).arg(%ident%); :}
                    |LPAREN funcArg[COMMA]:args? RPAREN_MINUSGT:sym
                    {: yield FunctionLiteralBuilder.create(assembler.vars(), %sym.symbol%.pos).args(%args%); :}
                    ;


lambdaExpr      ::= lambdaExprHead:builder expression:expr
                    {: yield (%builder%).buildAndAssign(%expr%); :}
                    |lambdaExprHead:builder LBRACE statement[]:list RBRACE
                    {: yield (%builder%).buildAndAssign(%list%); :}
                    ;

