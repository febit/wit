package org.febit.wit.parser;

import org.febit.wit.exception.ScriptParseException;
import org.febit.wit.parser.Ast.*;
import org.febit.wit.runtime.ALU;
import org.febit.wit.runtime.ast.*;
import org.febit.wit.runtime.ast.expr.*;
import org.febit.wit.runtime.ast.expr.NewMap.NewMapEntry;
import org.febit.wit.runtime.ast.extra.*;
import org.febit.wit.runtime.ast.statement.*;
import org.febit.wit.util.ClassNameRope;

import java.util.List;

import static org.febit.wit.parser.FunctionDeclarerBuilder.ArgumentInfo;

/* Terminals */
terminal Integer    VAR,
                    IF, ELSE,
                    FOR,
                    THIS, SUPER,
                    SWITCH, CASE, DEFAULT,
                    DO, WHILE,
                    THROW, TRY, CATCH, FINALLY,
                    NEW,
                    INSTANCEOF,
                    FUNCTION,
                    ECHO,
                    STATIC, NATIVE,
                    IMPORT, INCLUDE, NATIVE_IMPORT,
                    BREAK, CONTINUE, RETURN,

                    PLUSPLUS, MINUSMINUS,  // ++ ==
                    PLUS, MINUS, MULTI, DIV, MOD,  // + - * /
                    LSHIFT, RSHIFT, URSHIFT,  // << >> >>>
                    LT, GT, LTEQ, GTEQ, EQEQ, NOTEQ,  // < > <= >= == !=
                    AND, XOR, OR, COMP,  // & ^ | ~
                    ANDAND, OROR, NOT,  // && || !
                    QUESTION,// ?
                    SELFEQ,  // (+ - * / %)= (<< >> >>>)= (& ^ |)=
                    UMINUS,
                    DOT,  // .
                    COLON, COLONCOLON,  // : ::
                    COMMA,  // ,
                    SEMICOLON,  // ;
                    LBRACE, RBRACE, INTERPOLATION_END, // { }
                    LPAREN, RPAREN,  // ( )
                    LBRACK, RBRACK,  // [ ]
                    LDEBUG, RDEBUG, LRDEBUG,  // [? ?] [?]
                    EQGT,  // =>
                    RPAREN_MINUSGT, MINUSGT, // )-> ->
                    DYNAMIC_DOT, // @ .~
                    DOTDOT,  // ..
                    EQ,   // =
                    TEMPLATE_STRING_START, TEMPLATE_STRING_INTERPOLATION_END;


terminal String     TEMPLATE_STRING_INTERPOLATION_START, TEMPLATE_STRING_END, IDENTIFIER, METHOD_REFERENCE; // Ident, MethodReference
terminal char[]     TEXT_STATEMENT;
terminal Object     DIRECT_VALUE;
terminal Integer    CONST;

/* nonterminal */
nonterminal ClassNameRope classPureName, className;
nonterminal Class<?> javaClass;
nonterminal ScriptAST scriptAST;

/* Statement */
nonterminal Statement statement, ifStat, varPart;
nonterminal IBlock block, caseBlockStat;
nonterminal Expression varAssign;
nonterminal ImportBuilder importPart1, importPart2;
nonterminal SwitchBuilder switchPart, switchPart0;
nonterminal BaseForInBuilder forInHead, forInPart, lambdaForHead, lambdaForHead2;
nonterminal WhileBuilder whileBuilder;
nonterminal TryCatchBuilder tryPart, catchPart, finallyPart;

/* Expression */
nonterminal Expression expression, expressionStatementAble;
nonterminal NewMapEntry newMapEntry;
nonterminal NewMap newMapExpr;
nonterminal TemplateStringBuilder templateStringBuilder;
nonterminal Integer superCount;
nonterminal Expression contextValueExpr;

/* function & Lambda */
nonterminal ArgumentInfo funcArg;
nonterminal Expression funcExecuteExpr;
nonterminal FunctionDeclarerBuilder funcHead, funcStatementHead, mapPropertyFuncHead;
nonterminal Expression lambdaExpr;
nonterminal FunctionDeclarerBuilder lambdaExprHead;
nonterminal FunctionDeclarerBuilder lambdaForHead1, lambdaForMapHead1;

/* precedence */
precedence left     SEMICOLON; // ;
precedence left     COMMA; // ,
precedence left     LDEBUG; // [?
precedence left     RBRACK; // ]
precedence left     COLON;  // :
precedence right    SELFEQ, EQ; // (+ - * / %)=  (<< >> >>>)=  (& ^ |)=  =
precedence left     DOTDOT;  // ..
precedence right    QUESTION; // ?
precedence left     OROR; // ||
precedence left     ANDAND; // &&
precedence left     XOR; // ^
precedence left     OR; // |
precedence left     AND; // &
precedence left     EQEQ, NOTEQ; // == !=
precedence left     LT, LTEQ, GT, GTEQ; // < <= > >=  //Unsupport: instanceOf
precedence left     LSHIFT, RSHIFT, URSHIFT; // << >> >>>
precedence left     PLUS, MINUS; // + -
precedence left     MULTI, DIV, MOD; // * / %
precedence right    PLUSPLUS, MINUSMINUS, UMINUS, NOT, COMP; // ++ -- - ! ~
precedence left     EQGT;  // =>
precedence right    RPAREN_MINUSGT, MINUSGT; // ->
precedence left     DOT, LBRACK, LBRACE, LPAREN, RPAREN, DYNAMIC_DOT; // . [ { ( ) @


scriptAST       ::= statement[]:list ?
                    {: yield assembler.buildAST(%list%); :}
                    ;


classPureName   ::= IDENTIFIER:ident
                    {: yield new ClassNameRope(%ident%); :}
                    |classPureName:rope DOT IDENTIFIER:ident
                    {: yield (%rope%).append(%ident%); :}
                    ;

className       ::= classPureName:rope
                    {: yield %rope%; :}
                    |className:rope LBRACK RBRACK
                    {: yield (%rope%).increaseArrayDepth(); :}
                    ;


javaClass       ::= className:nameRope
                    {: yield assembler.toClass(%nameRope%, %nameRope.symbol%.pos); :}
                    ;


/* statements  */
statement       ::= expressionStatementAble:$ SEMICOLON
                    |SEMICOLON
                    {: yield NoopStatement.INSTANCE; :}

                    |LRDEBUG:sym
                    {: yield Ast.breakpointStatement(null, null, %sym.symbol%.pos); :}
                    |LDEBUG:sym expression:mark COLON RDEBUG
                    {: yield Ast.breakpointStatement(%mark%, null, %sym.symbol%.pos); :}

                    |expression:expr INTERPOLATION_END
                    {: yield Ast.interpolation(%expr%); :}

                    |block:$

                    |ifStat:$

                    // Switch
                    |switchPart:builder
                    {: yield (%builder%).label(0).build(); :}
                    |IDENTIFIER:label COLON switchPart:builder
                    {: yield (%builder%).label(assembler.getLabelIndex(%label%)).build(); :}

                    // While
                    |whileBuilder:builder
                    {: yield (%builder%).build(); :}
                    |IDENTIFIER:label COLON whileBuilder:builder
                    {: yield (%builder%).label(assembler.getLabelIndex(%label%)).build(); :}

                    //forIn
                    |forInPart:builder
                    {: yield (%builder%).label(0).build(); :}
                    |IDENTIFIER:label COLON forInPart:builder
                    {: yield (%builder%).label(assembler.getLabelIndex(%label%)).build(); :}

                    //RedirectOut
                    |block:stat EQGT:sym expression:expr SEMICOLON
                    {: yield Ast.renderRedirect(%stat%, Ast.castToAssignable(%expr%), %sym.symbol%.pos); :}

                    //textStat
                    |TEXT_STATEMENT:sym
                    {: yield assembler.createTemplateText(%sym%, %sym.symbol%.pos); :}

                    //
                    |CONST IDENTIFIER:ident EQ expression:expr SEMICOLON
                    {: assembler.assignConst(%ident%, %expr%, %ident.symbol%.pos); yield NoopStatement.INSTANCE; :}

                    //var
                    |VAR varPart[COMMA]:parts SEMICOLON
                    {: yield Ast.statementList(%parts%, %parts.symbol%.pos); :}

                    //echoStat
                    |ECHO:sym expression:expr SEMICOLON
                    {: yield Ast.echo(%expr%, %sym.symbol%.pos); :}

                    //@import
                    |NATIVE_IMPORT:sym classPureName:nameRope SEMICOLON
                    {: assembler.importClass(%nameRope%, %sym.symbol%.pos); yield NoopStatement.INSTANCE; :}

                    // Break
                    |BREAK:sym IDENTIFIER:label? SEMICOLON
                    {: yield new Break(assembler.getLabelIndex(%label%), %sym.symbol%.pos); :}

                    // Continue
                    |CONTINUE:sym IDENTIFIER:label? SEMICOLON
                    {: yield new Continue(assembler.getLabelIndex(%label%), %sym.symbol%.pos); :}

                    // Return
                    |RETURN:sym expression:expr? SEMICOLON
                    {: yield Ast.returnWith(%expr%, %sym.symbol%.pos); :}

                    // Import
                    |importPart1:builder SEMICOLON
                    {: yield (%builder%).build(); :}
                    |importPart2:builder SEMICOLON
                    {: yield (%builder%).build(); :}

                    //includeStat
                    |INCLUDE:sym expression:expr newMapExpr:paramsExpr? SEMICOLON
                    {: yield new Include(%expr%, %paramsExpr%, assembler.script().path(), %sym.symbol%.pos); :}

                    //funcStatement
                    |funcStatementHead:builder LBRACE statement[]:list? RBRACE
                    {: yield (%builder%).buildAndAssign(%list%); :}

                    //
                    |(catchPart:$ | finallyPart:$):builder
                    {: yield (%builder%).build(); :}

                    //
                    | THROW:sym expression:expr SEMICOLON
                    {: yield new Throw(%expr%, %sym.symbol%.pos); :}
                    ;


varAssign       ::= IDENTIFIER:ident EQ:sym (expression:$ | varAssign:$):expr
                    {: yield Ast.assign(assembler.declareVarAndCreateContextValue(%ident%, %ident.symbol%.pos), %expr%, %sym.symbol%.pos); :}
                    ;

varPart         ::= varAssign:$
                    | IDENTIFIER:ident
                    {: yield assembler.declareVar(%ident%, %ident.symbol%.pos); :}
                    | LBRACK IDENTIFIER[COMMA]:idents RBRACK EQ:sym expression:expr
                    {: yield Ast.groupAssign(assembler.declareVarAndCreateContextValues(%idents%, %idents.symbol%.pos), %expr%, %sym.symbol%.pos); :}
                    ;


importPart1     ::= IMPORT:sym expression:expr newMapExpr:paramsExpr?
                    {: yield Ast.importBuilder().script(assembler.script()).path(%expr%).params(%paramsExpr%).pos(%sym.symbol%.pos); :}
                    ;


importPart2     ::= importPart1:builder IDENTIFIER:ident
                    {: yield (%builder%).export(%ident%, assembler.createContextValue(0, %ident%, %ident.symbol%.pos)); :}
                    |importPart1:builder contextValueExpr:valueExpr EQ IDENTIFIER:ident
                    {: yield (%builder%).export(%ident%, %valueExpr%); :}
                    |importPart2:builder COMMA IDENTIFIER:ident
                    {: yield (%builder%).export(%ident%, assembler.createContextValue(0, %ident%, %ident.symbol%.pos)); :}
                    |importPart2:builder COMMA contextValueExpr:valueExpr EQ IDENTIFIER:ident
                    {: yield (%builder%).export(%ident%, %valueExpr%); :}
                    ;


block           ::= (LBRACE {: assembler.varLayout().shiftScope(); yield null; :}) statement[]:list? RBRACE
                    {: yield Ast.block(%list%, assembler.varLayout().unshiftScope(), %list.symbol%.pos); :}
                    ;


tryPart         ::= (TRY LBRACE {: assembler.varLayout().shiftScope(); yield null; :}):sym statement[]:list? RBRACE
                    {: yield Ast.tryCatchBuilder().body(Ast.block(%list%, assembler.varLayout().unshiftScope(), %list.symbol%.pos)).pos(%sym.symbol%.pos); :}
                    ;

catchPart       ::= tryPart:builder (CATCH LPAREN IDENTIFIER:ident RPAREN LBRACE {: assembler.varLayout().shiftScope(); yield assembler.varLayout().assignVar(%ident%, %ident.symbol%.pos); :}):varIndex statement[]:list? RBRACE
                    {: yield (%builder%).exceptionVarIndex((Integer)(%varIndex%)).catchBody(Ast.block(%list%, assembler.varLayout().unshiftScope(), %list.symbol%.pos)); :}
                    ;

finallyPart     ::= (tryPart:$ | catchPart:$):builder (FINALLY LBRACE {: assembler.varLayout().shiftScope(); yield null; :}) statement[]:list? RBRACE
                    {: yield (%builder%).finallyBody(Ast.block(%list%, assembler.varLayout().unshiftScope(), %list.symbol%.pos)); :}
                    ;


ifStat          ::= IF:sym LPAREN expression:expr RPAREN block:body (ELSE block:$ | ELSE ifStat:$):elseBody?
                    {: yield Ast.ifStatement(%expr%, %body%, (Statement) (%elseBody%), %sym.symbol%.pos); :}
                    ;

forInHead       ::= FOR:sym LPAREN IDENTIFIER:item COLON expression:items RPAREN
                    {: yield new ForInBuilder(%item%, assembler.varLayout(), %sym.symbol%.pos).collection(%items%).shiftScope(); :}
                    |FOR:sym LPAREN IDENTIFIER:key COMMA IDENTIFIER:value COLON expression:map RPAREN
                    {: yield new ForMapBuilder(%key%, %value%, assembler.varLayout(), %sym.symbol%.pos).collection(%map%).shiftScope(); :}
                    ;


lambdaForHead1  ::= FOR LPAREN IDENTIFIER:ident MINUSGT:sym
                    {: yield FunctionDeclarerBuilder.create(assembler.varLayout(), %sym.symbol%.pos).arg(%ident%); :}
                    ;


lambdaForMapHead1   ::= FOR LPAREN IDENTIFIER:key COMMA IDENTIFIER:value MINUSGT:sym
                    {: yield FunctionDeclarerBuilder.create(assembler.varLayout(), %sym.symbol%.pos).arg(%key%).arg(%value%); :}
                    ;


lambdaForHead2  ::= lambdaForHead1:builder expression:expr COLON
                    {: yield new ForInBuilder((%builder%).getArg(0), assembler.varLayout(), %builder.symbol%.pos).filter((%builder%).build(%expr%)); :}
                    |lambdaForHead1:builder LBRACE statement[]:list RBRACE COLON
                    {: yield new ForInBuilder((%builder%).getArg(0), assembler.varLayout(), %builder.symbol%.pos).filter((%builder%).build(%list%)); :}
                    |lambdaForMapHead1:builder expression:expr COLON
                    {: yield new ForMapBuilder((%builder%).getArg(0), (%builder%).getArg(1), assembler.varLayout(), %builder.symbol%.pos).filter((%builder%).build(%expr%)); :}
                    |lambdaForMapHead1:builder LBRACE statement[]:list RBRACE COLON
                    {: yield new ForMapBuilder((%builder%).getArg(0), (%builder%).getArg(1), assembler.varLayout(), %builder.symbol%.pos).filter((%builder%).build(%list%)); :}
                    ;


lambdaForHead   ::= lambdaForHead2:builder expression:items RPAREN
                    {: yield (%builder%).collection(%items%).shiftScope(); :}
                    ;


forInPart       ::= (forInHead:$ | lambdaForHead:$):builder LBRACE statement[]:list? RBRACE (ELSE block:$):elseBody?
                    {: yield (%builder%).body(%list%).elseBody(%elseBody%); :}
                    ;


whileBuilder       ::= WHILE:sym LPAREN expression:condition RPAREN block:body
                    {: yield Ast.whileBuilder().kind(WhileKind.WHILE).condition(%condition%).body(%body%).pos(%sym.symbol%.pos); :}
                    |DO:sym block:body WHILE LPAREN expression:condition RPAREN SEMICOLON
                    {: yield Ast.whileBuilder().kind(WhileKind.DO_WHILE).condition(%condition%).body(%body%).pos(%sym.symbol%.pos); :}
                    ;


caseBlockStat   ::= {: assembler.varLayout().shiftScope(); yield null; :} statement[]:list?
                    {: yield Ast.block(%list%, assembler.varLayout().unshiftScope(), %list.symbol%.pos); :}
                    ;


switchPart0     ::=
                    {: yield Ast.switchBuilder(); :}
                    | CASE:sym MINUS:negative? DIRECT_VALUE:key COLON caseBlockStat:body switchPart0:builder
                    {: yield (%builder%).branch((%negative% == null)?(%key%):ALU.negative(%key%), %body%, %sym.symbol%.pos); :}
                    | DEFAULT:sym COLON caseBlockStat:body switchPart0:builder
                    {: yield (%builder%).branch(null, %body%, %sym.symbol%.pos); :}
                    ;


switchPart      ::= SWITCH:sym LPAREN expression:switchExpr RPAREN LBRACE TEXT_STATEMENT ? switchPart0:builder RBRACE
                    {: yield (%builder%).condition(%switchExpr%, %sym.symbol%.pos); :}
                    ;



/* Expressions */

expressionStatementAble ::=
                    //assignOp =
                    expression:lexpr EQ:sym expression:expr
                    {: yield Ast.assign(Ast.castToAssignable(%lexpr%), %expr%, %sym.symbol%.pos); :}

                    |LBRACK expression[COMMA]:list COMMA? RBRACK EQ:sym expression:expr
                    {: yield Ast.groupAssign(Ast.toExpressionArray(%list%), %expr%, %sym.symbol%.pos); :}

                    // Increase ++
                    |PLUSPLUS:sym expression:expr
                    {: yield Ast.increaseAndGet(Ast.castToAssignable(%expr%), %sym.symbol%.pos); :}
                    |expression:expr PLUSPLUS:sym
                    {: yield Ast.getAndIncrease(Ast.castToAssignable(%expr%), %sym.symbol%.pos); :}

                    // Decrease --
                    |MINUSMINUS:sym expression:expr
                    {: yield Ast.decreaseAndGet(Ast.castToAssignable(%expr%), %sym.symbol%.pos); :}
                    |expression:expr MINUSMINUS:sym
                    {: yield Ast.getAndDecrease(Ast.castToAssignable(%expr%), %sym.symbol%.pos); :}

                    //selfOp
                    |expression:lexpr SELFEQ:sym expression:rexpr
                    {: yield Ast.selfAssign(%lexpr%, %rexpr%, %sym%, %sym.symbol%.pos); :}

                    //
                    |funcExecuteExpr:$
                    ;


expression      ::= expressionStatementAble:$

                    |LDEBUG:sym expression:expr RDEBUG
                    {: yield Ast.breakpointExpr(null, %expr%, %sym.symbol%.pos); :}

                    |LDEBUG:sym expression:mark COLON expression:expr RDEBUG
                    {: yield Ast.breakpointExpr(%mark%, %expr%, %sym.symbol%.pos); :}

                    //bitNotOp ~
                    |COMP:sym expression:expr
                    {: yield Ast.operator(%expr%, %sym.symbol%); :}

                    //negativeOp  -
                    |MINUS:sym expression:expr %prec UMINUS
                    {: yield Ast.operator(%expr%, %sym.symbol%); :}

                    //notOp !
                    |NOT:sym expression:expr
                    {: yield Ast.operator(%expr%, %sym.symbol%); :}

                    // Fixed property .
                    |expression:expr DOT:sym IDENTIFIER:ident
                    {: yield Ast.property(%expr%, %ident%, %sym.symbol%.pos); :}

                    // property []
                    |expression:lexpr LBRACK:sym expression:rexpr RBRACK
                    {: yield Ast.property(%lexpr%, %rexpr%, %sym.symbol%.pos); :}

                    /***********  binaries *************/
                    //-- binary:  *
                    |expression:lexpr MULTI:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  /
                    |expression:lexpr DIV:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  %
                    |expression:lexpr MOD:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  +
                    |expression:lexpr PLUS:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  -
                    |expression:lexpr MINUS:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  <<
                    |expression:lexpr LSHIFT:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  >>
                    |expression:lexpr RSHIFT:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  >>>
                    |expression:lexpr URSHIFT:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  <
                    |expression:lexpr LT:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  <=
                    |expression:lexpr LTEQ:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  >
                    |expression:lexpr GT:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  >=
                    |expression:lexpr GTEQ:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  ==
                    |expression:lexpr EQEQ:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  !=
                    |expression:lexpr NOTEQ:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  &
                    |expression:lexpr AND:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  |
                    |expression:lexpr OR:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  ^
                    |expression:lexpr XOR:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  &&
                    |expression:lexpr ANDAND:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  ..
                    |expression:lexpr DOTDOT:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}
                    //-- binary:  ||
                    |expression:lexpr OROR:sym expression:rexpr
                    {: yield Ast.binaryOperator(%lexpr%, %rexpr%, %sym.symbol%); :}

                    // ? :
                    |expression:ifExpr QUESTION:sym expression:lexpr COLON expression:rexpr
                    {: yield Ast.ifExpr(%ifExpr%, %lexpr%, %rexpr%, %sym.symbol%.pos); :}

                    //
                    |DIRECT_VALUE:sym
                    {: yield Ast.directValue(%sym.symbol%); :}

                    // ()
                    |LPAREN expression:$ RPAREN

                    //funcDeclareExpr
                    |funcHead:builder LBRACE statement[]:list? RBRACE
                    {: yield (%builder%).buildAndAssign(%list%); :}

                    //arrayValue
                    |LBRACK:sym RBRACK
                    {: yield Ast.emptyArray(%sym.symbol%.pos); :}
                    |LBRACK:sym expression[COMMA]:list COMMA? RBRACK
                    {: yield Ast.newArray(%list%, %sym.symbol%.pos); :}

                    //NativeNewArrayDeclareExpression
                    |NATIVE:sym LBRACK RBRACK javaClass:javaClass
                    {: yield assembler.createNewArrayNativeFunctionValue(%javaClass%, %sym.symbol%.pos); :}

                    //nativeMethodExpr
                    |NATIVE:sym classPureName:nameRope DOT IDENTIFIER:ident LPAREN javaClass[COMMA]:list? RPAREN
                    {: yield assembler.createMethodNativeFunctionValue(assembler.toClass(%nameRope%, %nameRope.symbol%.pos), %ident%, %list%, %sym.symbol%.pos); :}

                    //native static field
                    |NATIVE classPureName:nameRope
                    {: yield assembler.createNativeStaticFieldValue(%nameRope%, %nameRope.symbol%.pos); :}

                    //nativeConstructorExpr
                    |NATIVE:sym NEW classPureName:nameRope LPAREN javaClass[COMMA]:list? RPAREN
                    {: yield assembler.createConstructorNativeFunctionValue(assembler.toClass(%nameRope%, %nameRope.symbol%.pos), %list%, %sym.symbol%.pos); :}

                    |METHOD_REFERENCE:ref
                    {: yield assembler.createMethodReference(%ref%, %ref.symbol%.pos); :}

                    |contextValueExpr:$
                    |newMapExpr:$

                    //Lambda
                    |lambdaExpr:$

                    // script string
                    |templateStringBuilder:builder TEMPLATE_STRING_END:end
                    {: yield (%builder%).segment(Ast.directValue(%end.symbol%)).build(); :}
                    ;

// super
superCount      ::= SUPER DOT
                    {: yield 1; :}
                    |superCount:count SUPER DOT
                    {: yield %count% + 1; :}
                    ;


// ident  super...ident  this.ident

contextValueExpr    ::= IDENTIFIER:ident
                        {: yield assembler.createContextValue(0, %ident%, %ident.symbol%.pos); :}
                        |superCount:count IDENTIFIER:ident
                        {: yield assembler.createContextValue(%count%, %ident%, %ident.symbol%.pos); :}
                        |FOR DOT IDENTIFIER:ident
                        {: yield assembler.createContextValue(0, ("for." + %ident%), %ident.symbol%.pos); :}
                        |superCount:count FOR DOT IDENTIFIER:ident
                        {: yield assembler.createContextValue(%count%, ("for." + %ident%), %ident.symbol%.pos); :}
                        ;

// map {key:expr, ...}

newMapEntry         ::= DIRECT_VALUE:key COLON expression:expr
                        {: yield Ast.entryOfNewMap(Ast.directValue(%key.symbol%), %expr%); :}
                        |MINUS:sym DIRECT_VALUE:key COLON expression:expr
                        {: yield Ast.entryOfNewMap(Ast.directValue(ALU.negative(%key%), %key.symbol%.pos), %expr%); :}
                        |IDENTIFIER:ident
                        {: yield Ast.entryOfNewMap(Ast.directValue(%ident.symbol%), assembler.createContextValue(0, %ident%, %ident.symbol%.pos)); :}
                        |IDENTIFIER:ident COLON expression:expr
                        {: yield Ast.entryOfNewMap(Ast.directValue(%ident.symbol%), %expr%); :}
                        // |IDENTIFIER:ident mapPropertyFuncHead:builder LBRACE statement[]:list? RBRACE
                        // {: yield Ast.entryOfNewMap(Ast.directValue(%ident.symbol%), (%builder%).build(%list%)); :}
                        |LBRACK expression:key RBRACK COLON expression:expr
                        {: yield Ast.entryOfNewMap(%key%, %expr%); :}
                        ;


newMapExpr          ::= LBRACE:sym RBRACE
                        {: yield Ast.newMap(List.of(), %sym.symbol%.pos); :}
                        |LBRACE:sym newMapEntry[COMMA]:entries COMMA? RBRACE
                        {: yield Ast.newMap(%entries%, %sym.symbol%.pos); :}
                        ;


templateStringBuilder  ::= TEMPLATE_STRING_START:sym
                            {: yield Ast.templateStringBuilder().pos(%sym.symbol%.pos); :}
                            | templateStringBuilder:builder TEMPLATE_STRING_INTERPOLATION_START:start expression:segment TEMPLATE_STRING_INTERPOLATION_END
                            {: yield (%builder%).segment(Ast.directValue(%start.symbol%)).segment(%segment%); :}
                            ;

/* function  */
funcArg             ::= IDENTIFIER:ident
                        {: yield new ArgumentInfo(%ident%, null); :}
                        | IDENTIFIER:ident EQ expression:expr
                        {: yield new ArgumentInfo(%ident%, StatementUtils.evalAsConst(%expr%)); :}
                        ;


funcStatementHead   ::= FUNCTION:sym IDENTIFIER:ident LPAREN funcArg[COMMA]:args? RPAREN
                        {: yield FunctionDeclarerBuilder.create(assembler.varLayout(), assembler.varLayout().assignVar(%ident%, %ident.symbol%.pos), %sym.symbol%.pos).args(%args%); :}
                        ;

// mapPropertyFuncHead ::= LPAREN:sym funcArg[COMMA]:args? RPAREN
//                         {: yield FunctionDeclarerBuilder.create(assembler.varLayout(), %sym.symbol%.pos).args(%args%); :}
//                         ;

funcHead            ::= FUNCTION:sym LPAREN funcArg[COMMA]:args? RPAREN
                        {: yield FunctionDeclarerBuilder.create(assembler.varLayout(), %sym.symbol%.pos).args(%args%); :}
                        ;

funcExecuteExpr     ::= expression:funcExpr LPAREN RPAREN
                        {: yield Ast.functionCall(%funcExpr%, ExpressionArray.ofEmpty(), %funcExpr.symbol%.pos); :}
                        |expression:funcExpr LPAREN expression[COMMA]:list COMMA? RPAREN
                        {: yield Ast.functionCall(%funcExpr%, Ast.toExpressionArray(%list%), %funcExpr.symbol%.pos); :}
                        |expression:param0 DYNAMIC_DOT IDENTIFIER:ident LPAREN RPAREN
                        {: yield Ast.dynamicNativeMethodCall(%param0%, %ident%, ExpressionArray.ofEmpty(), %ident.symbol%.pos); :}
                        |expression:param0 DYNAMIC_DOT IDENTIFIER:ident LPAREN expression[COMMA]:list COMMA? RPAREN
                        {: yield Ast.dynamicNativeMethodCall(%param0%, %ident%, Ast.toExpressionArray(%list%), %ident.symbol%.pos); :}
                        ;


/* lambda */
lambdaExprHead      ::= IDENTIFIER:ident MINUSGT:sym
                        {: yield FunctionDeclarerBuilder.create(assembler.varLayout(), %sym.symbol%.pos).arg(%ident%); :}
                        |LPAREN funcArg[COMMA]:args? RPAREN_MINUSGT:sym
                        {: yield FunctionDeclarerBuilder.create(assembler.varLayout(), %sym.symbol%.pos).args(%args%); :}
                        ;


lambdaExpr          ::= lambdaExprHead:builder expression:expr
                        {: yield (%builder%).buildAndAssign(%expr%); :}
                        |lambdaExprHead:builder LBRACE statement[]:list RBRACE
                        {: yield (%builder%).buildAndAssign(%list%); :}
                        ;

