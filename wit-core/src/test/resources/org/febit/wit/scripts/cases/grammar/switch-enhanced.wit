{
  var func_switch = function(a) {
    return switch (a) {
      case -1 -> "-1"
      case 1 -> "1"
      case 2, 3 -> "2|3"
      default -> "default"
    };
  };

  assertEquals("-1", func_switch(-1));
  assertEquals("1", func_switch(1));
  assertEquals("2|3", func_switch(2));
  assertEquals("2|3", func_switch(3));
  assertEquals("default", func_switch(100));
}

{
  var func_switch_stat_branch = function(a) {
    return switch (a) {
      case 1 -> {
        yield "1";
      }
      case 2 -> yield UNDEFINED;
      default -> {
        var value = "default";
        yield value;
      }
    };
  };

  assertEquals("1", func_switch_stat_branch(1));
  assertEquals(UNDEFINED, func_switch_stat_branch(2));
  assertEquals("default", func_switch_stat_branch(3));
}
