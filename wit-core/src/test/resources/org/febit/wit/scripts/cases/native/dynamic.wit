const a = 1;
const b = "bbb";
{
    assertEquals(3, "123".~length());
    assertEquals("2", "123".~substring(1,2));
}
{

    @import java.util.Map;
    @import java.util.HashMap;
    @import java.util.HashSet;

    const map = {
        "1": a,
        "2": b
    };

    assertEquals(a, map["1"]);
    assertEquals(b, map["2"]);

    map.~put("2", a);
    map.~put("3", b);
    assertEquals(a, map["2"]);
    assertEquals(b, map["3"]);
    assertEquals(3, map.~size());

    assertEquals(a, java.util.Map::get(map,"2"));
    assertEquals(3, java.util.Map :: size (map));

    var map2 = HashMap::new(map);
    assertEquals(3, java.util.Map :: size (map));
    assertEquals(3, Map::size(map2));
    assertEquals(a, map2["1"]);
    assertEquals(a, map2["2"]);
    assertEquals(b, HashMap::get(map,"3"));

    var values = HashSet::new(map2.~values());
    assertTrue(values.~contains(1));
    assertTrue(values.~contains(b));
    assertFalse(values.~contains("not exist"));

}
{
    @import java.util.Arrays;
    @import java.util.List;

    var list = Arrays::asList([1,2,3,"a","b","c"]);

    assertEquals(1, list[0]);
    assertEquals(2, List::get(list, 1));
    assertEquals("a", list[3]);
    assertEquals("b", List::get(list, 4));
}
{
  @import org.febit.wit.util.StringUtils;

  var max = Math::max;

  assertEquals(2, max(1,2));
  assertEquals(2, Math::max(1,2));
  assertEquals(1, Math::min(1,2));
  assertEquals(4, String::length("1234"));
  assertEquals("1234", String::valueOf("1234"));
  assertEquals("1234", String::valueOf(1234));

  assertEquals(1234, Integer::parseInt("1234"));
  assertEquals(1234L, Long::parseLong("1234"));

}
{
    var new_stringBuilder = native new StringBuilder();
    var buf = new_stringBuilder();

    buf.~append("123").~append(456);
    assertEquals("123456", buf.~toString());
    assertEquals("123456", StringBuilder::toString(buf));
}
{
    var buf = StringBuilder::new();
    StringBuilder::append(StringBuilder::append(buf, "123"), "233");
    assertEquals("123233", StringBuilder::toString(buf));

    buf = StringBuilder::new("233");
    assertEquals("233", buf.~toString());

    buf = StringBuilder::new(123);
    assertEquals(123, buf.~capacity());
}
{

    var arr

    arr = int[]::new(2)
    arr[1] = 100
    assertEquals(2, arr.length)
    assertEquals(100, arr[1])

    arr = int[][]::new(100)
    arr[99] = int[]::new(2)
    assertEquals(100, arr.length)
    assertEquals(2, arr[99].length)
    assertEquals(0, arr[99][0])

    arr = String[][]::new(1)
    arr = StringBuilder[][][]::new(1)
    arr = Map[][][][]
            ::new(1)

    arr.~toString()
    arr.~hashCode()
    Map[][][][]::hashCode(arr)
    Map [ ] []   [   ] [
         ]
        ::
        toString(arr)
}
