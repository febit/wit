{
  var a = 0;
  label: for (i : 0..3) {
    if (i == 2) {
        break label;
    }
    a += i;
  }
  assertEquals(1, a);
}

{
  var a = ""
  outer: for (i : 1..5) {
    inner: for (j : 1..4) {
        if (i == 1 && j == 2) {
            continue outer;
        }
        if (i == 2 && j == 3) {
            continue;
        }
        if (i == 3 && j == 3) {
            break inner;
        }
        if (i == 4 && j == 3) {
            break outer;
        }
        a += "(" + i + "," + j + ")";
    }
  }
  assertEquals("(1,1)(2,1)(2,2)(2,4)(3,1)(3,2)(4,1)(4,2)", a);
}
