{
    var s = "";
    for(i : 3..6){
        s += for.iter.isOdd? "1":"0";
    }
    assertEquals("1010", s);
}
{
    var s = "";
    for(i : []){
    }
    assertEquals("", s);
}
{
    var s = "";
    for(i : 0..1){
      for(j : 2..3){
        var flag = (super.for.iter.isOdd ? 4 : 2)
                   + (for.iter.isOdd ? 1 : 0);
        s += flag;
      }
    }
    assertEquals("5432", s);
}
{
  var a = 0;
  for (i : 0..3) {
    a += i;
  }
  assertEquals(6, a);
}

{
  var a = 0;
  for (i : 0..3) {
    for (j : 0..3) {
      a += i * j;
    }
  }
  assertEquals(36, a);
}
{
  var a = 0;
  for (i : 0..3) {
    if (i == 2) {
      break;
    }
    a += i;
  }
  assertEquals(1, a);
}
{
  var a = 0;
  for (i : 0..3) {
    if (i == 2) {
      continue;
    }
    a += i;
  }
  assertEquals(4, a);
}
