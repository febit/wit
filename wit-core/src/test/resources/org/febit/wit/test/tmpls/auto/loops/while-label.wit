{
  var a = "";
  var i = 0;
  outer: while (i < 5) {
    i++;
    var j = 0;
    inner: while (j < 4) {
        j++;
        if (i == 1 && j == 2) {
            continue outer;
        }
        if (i == 2 && j == 3) {
            continue inner;
        }
        if (i == 3 && j == 3) {
            break;
        }
        if (i == 4 && j == 3) {
            break outer;
        }
        a += "(" + i + "," + j + ")";
    }
  }
  assertEquals("(1,1)(2,1)(2,2)(2,4)(3,1)(3,2)(4,1)(4,2)", a);
}
