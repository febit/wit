assertNull($LOCAL("a"));

{
    $LOCAL("a", "abc");
    assertEquals("abc", $LOCAL.a);
    assertEquals("abc", $LOCAL("a"));
    assertEquals("abc", $LOCAL["a"]);

    $LOCAL.a = "def";
    assertEquals("def", $LOCAL.a);

    $LOCAL["a"] = "ghi";
    assertEquals("ghi", $LOCAL("a"));
}
{
    // Case: null keys
    assertEquals(UNDEFINED, $LOCAL[null]);
    assertDoesNotThrow(() -> {
        $LOCAL[null] = "x";
    });
    assertEquals(UNDEFINED, $LOCAL[null]);
}
{
    // Case: include
    $LOCAL("a", "abc");
    include "../lib/local.include.wit";
    assertEquals("def", $LOCAL("a"));
}
{
    // Case: Global function
    $LOCAL("a", "xxx");
    localTestInGlobal("a","xxx");
    localTestInGlobal_set("a", "yyy");
    assertEquals("yyy", $LOCAL("a"));
}
